{
  "name": "prettier-plugin-markdown-table-layout",
  "version": "0.1.0",
  "description": "Prettier plugin for compact and single-spaced markdown tables with configurable separators",
  "type": "module",
  "exports": "./src/index.js",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "format": "prettier --write \"{src,test}/**/*.js\" README.md package.json",
    "format:check": "prettier --check \"{src,test}/**/*.js\" README.md package.json"
  },
  "keywords": [
    "prettier-plugin",
    "markdown",
    "markdown-table",
    "token-optimization",
    "prompt-engineering",
    "formatter"
  ],
  "author": "Yulong Ming <i@myl7.org> (https://myl7.org)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luuuuuqui/prettier-plugin-markdown-table-layout.git"
  },
  "homepage": "https://github.com/luuuuuqui/prettier-plugin-markdown-table-layout",
  "bugs": {
    "url": "https://github.com/luuuuuqui/prettier-plugin-markdown-table-layout/issues"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "devDependencies": {
    "prettier": "^3.8.2",
    "vitest": "^4.1.4"
  }
}
